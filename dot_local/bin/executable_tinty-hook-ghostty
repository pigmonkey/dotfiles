#!/usr/bin/env bash
# Render a ghostty palette from tinty's colour environment variables.
#
# Ghostty has no upstream base16 template. Its native `theme = dark:x,light:y`
# support follows the XDG desktop portal, which this setup deliberately does
# not run, so the palette is written out explicitly instead.
set -u

hex() {
    eval "r=\${TINTY_SCHEME_PALETTE_${1}_HEX_R}"
    eval "g=\${TINTY_SCHEME_PALETTE_${1}_HEX_G}"
    eval "b=\${TINTY_SCHEME_PALETTE_${1}_HEX_B}"
    printf '#%s%s%s' "$r" "$g" "$b"
}

out="$HOME/.config/ghostty/colors"
mkdir -p "$(dirname "$out")"

{
    printf '# Generated by tinty from %s. Do not edit.\n' "${TINTY_SCHEME_ID}"
    printf 'background = %s\n' "$(hex BASE00)"
    printf 'foreground = %s\n' "$(hex BASE05)"
    printf 'cursor-color = %s\n' "$(hex BASE05)"
    printf 'selection-background = %s\n' "$(hex BASE02)"
    printf 'selection-foreground = %s\n' "$(hex BASE05)"
    for pair in "0 BASE00" "1 BASE08" "2 BASE0B" "3 BASE0A" \
                "4 BASE0D" "5 BASE0E" "6 BASE0C" "7 BASE05" \
                "8 BASE03" "9 BASE08" "10 BASE0B" "11 BASE0A" \
                "12 BASE0D" "13 BASE0E" "14 BASE0C" "15 BASE07"; do
        set -- $pair
        printf 'palette = %s=%s\n' "$1" "$(hex "$2")"
    done
} > "$out"
