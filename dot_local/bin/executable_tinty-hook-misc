#!/usr/bin/env bash
# Recolour applications that base16 templates do not serve.
#
# btop, i3status and dunst are handled here for *live* switching, but their
# configs are also chezmoi templates that derive the same values from tinty's
# current_scheme file. Both writers must agree, or chezmoi apply will prompt.
# bat is deliberately absent: BAT_THEME is exported by the shell instead.
set -u

hex() {
    eval "r=\${TINTY_SCHEME_PALETTE_${1}_HEX_R}"
    eval "g=\${TINTY_SCHEME_PALETTE_${1}_HEX_G}"
    eval "b=\${TINTY_SCHEME_PALETTE_${1}_HEX_B}"
    printf '#%s%s%s' "$r" "$g" "$b"
}

variant="${TINTY_SCHEME_VARIANT}"   # "light" or "dark"

# btop ships stock gruvbox themes for both variants.
btop_conf="$HOME/.config/btop/btop.conf"
if [ -f "$btop_conf" ]; then
    sed -i "s|^color_theme = .*|color_theme = \"/usr/share/btop/themes/gruvbox_${variant}.theme\"|" \
        "$btop_conf"
fi

# i3status. These literals must stay in step with
# dot_config/i3status/config.tmpl, which renders the same values. They are
# gruvbox-specific rather than derived from $TINTY_SCHEME_PALETTE, because
# base16 maps base0B to gruvbox's bright green, which is louder than everything
# else in the bar.
i3status_conf="$HOME/.config/i3status/config"
if [ -f "$i3status_conf" ]; then
    if [ "$variant" = "light" ]; then
        good="#79740e"; bad="#9d0006"; quiet="#665c54"
    else
        good="#98971a"; bad="#fb4934"; quiet="#bdae93"
    fi
    awk -v good="$good" -v bad="$bad" -v quiet="$quiet" '
        /^[a-z].*\{/            { section = $1 }
        /^\}/                   { section = "" }
        section == "general" && /^[[:space:]]*color_good[[:space:]]*=/ {
            sub(/=.*/, "= \"" good "\""); print; next }
        section == "general" && /^[[:space:]]*color_bad[[:space:]]*=/ {
            sub(/=.*/, "= \"" bad "\""); print; next }
        (section == "wireless" || section == "ethernet") && /^[[:space:]]*color_bad[[:space:]]*=/ {
            sub(/=.*/, "= \"" quiet "\""); print; next }
        { print }
    ' "$i3status_conf" > "$i3status_conf.tmp" && mv "$i3status_conf.tmp" "$i3status_conf"
fi

# vim reads ~/.vimrc_background if it exists and otherwise falls back to a
# hardcoded dark gruvbox, so without this file vim never follows the theme.
vimbg="$HOME/.vimrc_background"
contrast="${TINTY_SCHEME_SLUG##*-}"
case "$TINTY_SCHEME_SLUG:$contrast" in
    gruvbox-*:soft|gruvbox-*:medium|gruvbox-*:hard)
        {
            printf "let g:gruvbox_contrast_%s = '%s'\n" "$variant" "$contrast"
            printf 'set background=%s\n' "$variant"
            printf 'colorscheme gruvbox\n'
        } > "$vimbg"
        ;;
    *)
        # Any other scheme falls back to base16-vim, which covers all 250+.
        printf 'colorscheme base16-%s\n' "$TINTY_SCHEME_SLUG" > "$vimbg"
        ;;
esac

# dunst. These values must stay in step with
# dot_config/dunst/dunstrc.d/create_90-colors.conf.tmpl, which seeds the
# identical file on a fresh chezmoi apply.
if [ -d "$HOME/.config/dunst" ]; then
    mkdir -p "$HOME/.config/dunst/dunstrc.d"
    cat > "$HOME/.config/dunst/dunstrc.d/90-colors.conf" <<EOF
# Written by tinty-hook-misc. Overwritten on every theme switch.

[global]
    frame_color = "$(hex BASE05)"
    separator_color = frame

[base16_low]
    msg_urgency = "low"
    background = "$(hex BASE00)"
    foreground = "$(hex BASE04)"
    frame_color = "$(hex BASE04)"

[base16_normal]
    msg_urgency = "normal"
    background = "$(hex BASE00)"
    foreground = "$(hex BASE05)"
    frame_color = "$(hex BASE05)"

[base16_critical]
    msg_urgency = "critical"
    background = "$(hex BASE08)"
    foreground = "$(hex BASE00)"
    frame_color = "$(hex BASE00)"
EOF
    dunstctl reload 2>/dev/null || true
fi

# zulip-term expects an underscored theme name.
zuliprc="$HOME/.config/zuliprc"
if [ -f "$zuliprc" ]; then
    sed -i "s|^theme=.*|theme=gruvbox_${variant}|" "$zuliprc"
fi
