[calendars]
    [[T]]
    path = ~/library/calendars/91572a29-41df-4c94-b296-38e9c5494116
    color = light blue

    [[T:S]]
    path = ~/library/calendars/de342c24-2a78-43a2-b6d5-7dfb66f21afc
    color = dark blue
    readonly = True

    [[W]]
    path = ~/library/calendars/c66496bb-1ea3-4fc2-80c6-e89b8d55c792
    color = light magenta
    readonly = True

    [[C]]
    path = ~/library/calendars/a674f451-bfc2-4035-87fd-4338caa2c68d
    color = yellow

    [[Personal]]
    path = ~/library/calendars/9b403768-1a13-4c2c-a4b9-798cddf7aba7
    color = dark red

    [[Holidays]]
    path = ~/library/calendars/e5ce1815-2841-4a9f-a9c1-3c2026548ebf
    color = dark green
    readonly = True

    [[Birthdays]]
    path = ~/library/contacts/Default
    type = birthdays
    color = dark green

[locale]
longdateformat = %Y-%m-%d
longdatetimeformat = %Y-%m-%d %H:%M
dateformat = %m-%d
datetimeformat = %m-%d %H:%M

[default]
default_calendar = Personal
print_new = event
highlight_event_days = True
timedelta = 3d

[highlight_days]
color = light blue
multiple = dark red


[keybindings]
external_edit = E
save = w
