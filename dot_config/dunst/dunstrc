[global]
    font = PragmataPro Liga 12

    # Show notifications on the monitor holding keyboard focus rather than
    # always on monitor 0.
    follow = keyboard

    # Hold notifications back rather than timing them out unseen while away
    # from the machine.
    idle_threshold = 120

    # Notification text only. Without this dunst draws an icon on the left.
    icon_position = off

    # Context menu prompt. Only the trailing colon differs from the default.
    dmenu = /usr/bin/dmenu -p dunst:

    # Thinner than the default 3px.
    frame_width = 1
    frame_color = "#d5c4a1"

# Fallback colors

[urgency_low]
    background = "#282828"
    foreground = "#bdae93"

[urgency_normal]
    background = "#282828"
    foreground = "#d5c4a1"

[urgency_critical]
    background = "#fb4934"
    foreground = "#282828"

# vim: ft=cfg
