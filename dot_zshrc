###########
# plugins #
###########

autoload -Uz compinit
compinit

source '/usr/share/zsh-antidote/antidote.zsh'
antidote load

eval "$(starship init zsh)"

###########
# History #
###########

setopt inc_append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt hist_verify
setopt pushd_ignore_dups
setopt hist_no_store

# History Substring Search
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Share history across all terminals.
setopt share_history

# Keep a ton of history.
HISTSIZE=100000
SAVEHIST=100000
HISTFILE=~/.zhistory
export HISTORY_IGNORE="(ls|l|ll|lt|[bf]g|exit|reset|clear|cd|cd ..|cd ../|pwd|date|* --help)"


########
# Misc #
########

source ~/.aliases

# Add ruby gems to the path.
if which ruby >/dev/null && which gem >/dev/null; then
    path=($(ruby -e 'puts Gem.user_dir')/bin $path)
fi

# Add node packages to the path.
test -r "$HOME/.node_modules/bin" && path=("$HOME/.node_modules/bin" $path)

# Use SSH completion for Mosh.
compdef mosh=ssh

# Menu completion
zstyle ':completion:*' menu select

# Prevent Pure from auto-pulling git repos.
PURE_GIT_PULL=0

# Reverse menu with shift-tab.
bindkey '^[[Z' reverse-menu-complete

# Enable direnv
eval "$(direnv hook zsh)"


######
# Vi #
######

bindkey -v
bindkey -M viins 'kj' vi-cmd-mode
bindkey -M vicmd "?" history-incremental-search-backward
bindkey -M vicmd "/" history-incremental-search-forward
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down


#######
# FZF #
#######

if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

rga-fzf() {
    RG_PREFIX="rga --files-with-matches"
    local file
    file="$(
        FZF_DEFAULT_COMMAND="$RG_PREFIX $@" \
            fzf --sort --preview="[[ ! -z {} ]] && rga --pretty --context 5 {q} {}" \
                --bind=tab:down,btab:up \
                --phony -q "$1" \
                --bind "change:reload:$RG_PREFIX {q}" \
                --preview-window="70%:wrap"
    )" &&
    echo "opening $file" &&
    xdg-open "$file"
}


########
# Pass #
########

# Setup alternative pass.
wpass() {
    PASSWORD_STORE_DIR="$ALTPASSDIR" pass "$@"
}
compdef -e 'PASSWORD_STORE_DIR=$ALTPASSDIR _pass' wpass

# Access pass
access() {
    PASSWORD_STORE_DIR="$ACCESSPASSDIR" pass "$@"
}
compdef -e 'PASSWORD_STORE_DIR=$ACCESSPASSDIR _pass' access

# Finance pass
fin() {
    PASSWORD_STORE_DIR="$FINPASSDIR" pass "$@"
}
compdef -e 'PASSWORD_STORE_DIR=$FINPASSDIR _pass' fin


#########
# Color #
#########

# Use ansi for bat on auspex for a simple 16-color set, rendered in the local
# terminal's palette.
if [[ "$HOST" == auspex ]]; then
    export BAT_THEME="ansi"
else
    export BAT_THEME_DARK="gruvbox-dark"
    export BAT_THEME_LIGHT="gruvbox-light"
fi

if command -v tinty > /dev/null 2>&1; then
    # tinty's hooks run in a subprocess, so they cannot set variables here.
    # Everything else it writes is a file; only BASE16_THEME, FZF_DEFAULT_OPTS
    # and LS_COLORS need pulling in.
    #
    # Done from precmd rather than a wrapper around tinty, so a shell that was
    # already open when the theme changed picks it up at its next prompt. A
    # wrapper only ever fixes the shell it was run from.
    _tinty_sync_shell() {
        local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
        local marker="$data_dir/current_scheme"
        [[ -f "$marker" ]] || return 0

        local scheme="$(<"$marker")"
        [[ "$scheme" == "$_TINTY_ACTIVE_SCHEME" ]] && return 0
        _TINTY_ACTIVE_SCHEME="$scheme"

        # Derived here rather than imported, so no third-party code has to run
        # in this shell just to set it.
        export BASE16_THEME="${scheme#*-}"

        # Repaint the terminal's palette. Executed, not sourced: the script
        # writes its escape sequences straight to $TTY, so only the side effect
        # is wanted, and running it keeps its helper functions out of this
        # shell.
        local palette="$data_dir/shell-scripts-file.sh"
        if [[ -r "$palette" ]]; then
            TTY="${TTY:-/dev/tty}" command sh "$palette" > /dev/null 2>&1
        fi

        # fzf's value does have to land in this shell. Run its file in a
        # subshell and capture the result rather than sourcing it. That keeps
        # the same no-foreign-code property, and starting from an empty value
        # avoids unbounded growth: the generated file appends to whatever
        # FZF_DEFAULT_OPTS already holds.
        local fzf_theme="$data_dir/fzf-sh-file.sh"
        if [[ -r "$fzf_theme" ]]; then
            export FZF_DEFAULT_OPTS="$(
                FZF_DEFAULT_OPTS= command sh -c '. "$1"; printf %s "$FZF_DEFAULT_OPTS"' _ "$fzf_theme"
            )"
        fi

        if command -v vivid > /dev/null 2>&1 \
           && [[ -f "$HOME/.config/vivid/themes/tinty.yml" ]]; then
            export LS_COLORS="$(vivid generate tinty)"
        fi
    }

    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _tinty_sync_shell
fi
